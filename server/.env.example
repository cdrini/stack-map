# Copy this file to .env (git-ignored) and fill in the real values — never
# commit real internal hostnames, here or anywhere else in this repo.

# Optional — defaults to ../src/stack.yaml (local dev's own git-ignored
# copy). Deployments that don't have that file on disk (e.g. the Docker
# image) should mount it somewhere and point this at it instead, e.g.
# STACKMAP_SPEC_PATH=/data/stack.yaml
# STACKMAP_SPEC_PATH=../src/stack.yaml

# Graphite's /render endpoint, exactly as it appears in stack.yaml's
# `source:` field for collectd-backed metrics.
STACKMAP_GRAPHITE_SOURCE=http://graphite.example.internal/render

# Prometheus's base URL, exactly as it appears in stack.yaml's `source:`
# field for haproxy-*/solr-* metrics.
STACKMAP_PROMETHEUS_SOURCE=http://prometheus.example.internal:9090

# Optional — see the comment above PROMETHEUS_URL_OVERRIDE in main.py.
# STACKMAP_PROMETHEUS_URL_OVERRIDE=http://host.docker.internal:19090

# No CORS at all (cross-origin requests blocked) unless this is set —
# local dev opts into "*" itself, on purpose, rather than that being the
# built-in default. In production, set this to the deployed frontend's
# exact origin instead (comma-separated if more than one), e.g.
# STACKMAP_CORS_ALLOWED_ORIGINS=https://stackmap.example.com
STACKMAP_CORS_ALLOWED_ORIGINS=*
